<Project>

  <!-- 集中包版本管理（CPM）：新增项目时只需 PackageReference，无需重复写版本号。 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Windows App SDK 必须是 2.x 版本线：
      Microsoft.UI.Reactor 0.1.0-preview.16 依赖 Microsoft.WindowsAppSDK.WinUI >= 2.2.1，
      而 Windows App SDK 1.8 携带的是 WinUI 1.8，会触发 NU1107 版本冲突。
    -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageVersion Include="Microsoft.UI.Reactor" Version="0.1.0-preview.16" />
    <!--
      显式钉住 WinUI 子包版本：WASDK 2.5.1 传递的是 WinUI 2.3.9。
      CommunityToolkit 的 SettingsControls 依赖 WinUI >= 1.8.260204000，2.3.9 满足该下限，
      不会触发 NU1107；此处显式声明是为了在 toolkit 将来抬高下限时第一时间暴露冲突，
      而不是被 NuGet 悄悄选一个版本。
    -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <!--
      只引子包、不引 Microsoft.WindowsAppSDK 元包（理由见 YuumiX.App.csproj）：
      元包会拉入 AI / ML / Search / Widgets，其中 AI 带 onnxruntime(20.7M) + DirectML(17.8M)。
      下列子包版本与元包 2.5.1 的传递解析结果一致，显式钉住是为了避免 NU1603
      （WinUI 2.3.9 要求 InteractiveExperiences >= 2.1.8，而实际可用的只有 2.1.9）。
    -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <!-- SettingsCard / SettingsExpander：Windows 11 设置页的原生 Fluent 实现（WinUI 3 Gallery 同款） -->
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.3.260402-preview2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 领域层：DI 与日志（架构文档「五、依赖选型」） -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- 云端服务：SignalR 客户端（requirements-settings.md S5，对应旧 signalr.rs 的手写协议栈；
         官方客户端自带协商/握手/自动重连，替代旧实现的 tokio-tungstenite 手工封装） -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试：xUnit，对标原项目 cargo test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- 门禁（requirements-fluent-refactor.md R17）：BannedSymbols.txt 驱动的禁用 API 分析器，
         配合 App 项目 TreatWarningsAsErrors 让禁用 API 的引用直接构建失败。 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

</Project>
