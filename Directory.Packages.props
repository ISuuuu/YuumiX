<Project>

  <!-- 集中包版本管理（CPM）：新增项目时只需 PackageReference，无需重复写版本号。 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Windows App SDK 必须是 2.x 版本线：
      Microsoft.UI.Reactor 0.1.0-preview.16 依赖 Microsoft.WindowsAppSDK.WinUI >= 2.2.1，
      而 Windows App SDK 1.8 携带的是 WinUI 1.8，会触发 NU1107 版本冲突。
    -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageVersion Include="Microsoft.UI.Reactor" Version="0.1.0-preview.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- 领域层：DI 与日志（架构文档「五、依赖选型」） -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- 云端服务：SignalR 客户端（requirements-settings.md S5，对应旧 signalr.rs 的手写协议栈；
         官方客户端自带协商/握手/自动重连，替代旧实现的 tokio-tungstenite 手工封装） -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试：xUnit，对标原项目 cargo test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
