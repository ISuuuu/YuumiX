<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>YuumiX.AotVerification</RootNamespace>

    <!--
      AOT 验收专用进程（docs/internal/2026-11-01-native-aot-requirements.md §5.1「JSON / 配置 / SignalR」行）：
      以 IsReflectionEnabledByDefault=false 运行，等价于 AOT 成品里「反射序列化已关闭」的前提。
      逐段执行 Core 的真实生产序列化路径 + 本地 Kestrel Hub 的 SignalR 全链路；
      任何未登记源生成元数据的类型都会在此直接抛 NotSupportedException（测试期暴露，而不是发布后）。

      不进 slnx（不是单测，是验收入口），按需运行：
        dotnet run 加 project 参数指向 tests/YuumiX.AotVerification/YuumiX.AotVerification.csproj，并带 -p:Platform=x64
    退出码 0 = 全部通过。
    -->
  </PropertyGroup>

  <!-- 关闭 JSON 反射序列化：等价 AOT 成品前提，未登记源生成元数据的类型直接抛异常 -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault" Value="false" Trim="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本地 SignalR Hub 服务端需要 ASP.NET Core 共享框架 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/YuumiX.Core/YuumiX.Core.csproj" />
  </ItemGroup>

</Project>
