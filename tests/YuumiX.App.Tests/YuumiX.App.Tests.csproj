<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 与 YuumiX.App 同 TFM：调和决策层虽是纯托管逻辑，但类型定义在 App 程序集内
         （Element/MountedItem），测试工程必须同平台家族才能引用。 -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>YuumiX.App.Tests</RootNamespace>
    <Platforms>x64</Platforms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 测试工程通过 InternalsVisibleTo 访问 YuumiX.App 内部成员；关闭测试工程自身的
         ReactorSourceMap 源生成，避免 preview.17 生成的 internal ReactorSourceMapStaticInfo
         与主工程同名内部类型产生 CS0436 冲突。 -->
    <ReactorSourceMap>false</ReactorSourceMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/YuumiX.App/YuumiX.App.csproj" />
  </ItemGroup>

</Project>
