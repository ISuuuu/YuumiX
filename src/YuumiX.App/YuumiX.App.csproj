<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- 产品名与根命名空间分离：exe 叫 YuumiX，代码命名空间保留 .App 分层，
         便于后续新增 YuumiX.Core 等领域项目。 -->
    <AssemblyName>YuumiX</AssemblyName>
    <RootNamespace>YuumiX.App</RootNamespace>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- exe 内嵌图标：资源管理器 / 快捷方式 / 任务栏在窗口尚未 SetIcon 时都读这一份。
         多尺寸只写在 .ico 里，不要在此处指定 PNG（PE 资源仅接受 .ico）。 -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <!-- 仅保留 x64：英雄联盟客户端只有 x64 版本，无需 ARM64（见 slnx 注释）。
         平台不再靠 -p:Platform 推导：RID 显式写死 win-x64，省略 -p:Platform 也能正常构建。 -->
    <Platforms>x64</Platforms>
    <!-- SelfContained 需要 RID：显式声明，避免依赖 Platform 推导 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <!-- 非打包模式：与原 Yuumi 的便携版分发形态一致，且无需 MSIX 注册即可运行 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <NoWarn>$(NoWarn);REACTOR_THEME_001</NoWarn>
    <!-- 门禁终态（AGENTS.md §0 / R17）：BannedApiAnalyzers 的 RS0030 随警告转错误，
         引用 BannedSymbols.txt 中禁用 API 的代码直接构建失败，取代"记得去跑"的人工 grep。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      CsWinRT AOT 生成需要 unsafe（CsWinRT aot-trimming 文档明示生成代码含 unsafe 块）。
      缺失时生成器会**静默跳过** ToolkitControls.cs 里 GeneratedWinRTExposedExternalType
      声明的 ObservableCollection<object> 向量暴露：JIT 构建靠反射兜底一切正常，
      AOT 成品在 SettingsExpander 模板应用时经 ItemsRepeater.set_ItemsSource 抛
      "Argument 'source' is not a supported vector"（stowed exception 0xc000027b）直接崩溃。
      实测于 windows.sdk.net.ref 10.0.22621.87 / SDK 11.0.100-rc.3；本仓库无手写 unsafe 代码，
      开启此开关仅放开 CsWinRT 生成物。
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 不引 Microsoft.WindowsAppSDK 元包：它会把 AI / ML / Search / Widgets 四组组件
         一并拉进来，其中 AI 带 onnxruntime.dll(20.7M) + DirectML.dll(17.8M)，全仓零使用，
         压缩后白占约 14MB。改为只引真正用到的子包。 -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <!-- 显式引用 InteractiveExperiences 以在顶层固定组件版本，与 WinUI / Runtime 保持 2.6.4 对齐。 -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.UI.Reactor" />
    <!-- 设置项容器（SettingsCard/SettingsExpander）。控件模板在包内 .pri 中，
         裁剪/AOT 时必须保留该程序集，见 Controls/ToolkitXamlMetadata.cs。 -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <!-- 纯分析器包：只进编译，不进运行时输出 -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    Reactor Devtools（仅 Debug）：开启后应用会在 %TEMP%/reactor-devtools/ 写 lockfile，
    由 `mur devtools <verb>` 自动发现会话，实现截图 / 元素树 / 点击 / hook 状态读取。
    这是 AGENTS.md §1.2「观感类改动必须用 Reactor devtools 截图对比验证」得以执行的前提。

    Release 不引：devtools 带本地 HTTP 监听与按名反射调用入口，且会让裁剪/AOT 分析器报未标注的反射。
    两道闸都要齐——缺包则能力不存在，缺开关则能力不启用，缺一不可。
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.UI.Reactor.Devtools" />
    <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport" Value="true" Trim="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- BannedSymbols.txt 的条目格式与文档注释 ID 一致（T:/M:/P:），条目含义见文件内注释 -->
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <!--
    Native AOT 验证入口（docs/internal/2026-11-01-native-aot-requirements.md R1）：
    仅当发布命令显式传 -p:PublishAot=true 时生效，常规 Debug/Release 构建与自包含发布路径完全不受影响。
    AOT 相关属性必须在 restore 阶段可见（ILCompiler 包、裁剪分析器、CsWinRT AOT 生成都在 restore 期接入），
    因此集中声明在此，由 `dotnet publish -c Release -r win-x64 -p:PublishAot=true` 一次性开启；
    禁止只在 publish 的 no-build 阶段临时追加属性。
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- 保留异常调用栈元数据，便于从 AOT 成品日志定位错误。 -->
    <StackTraceSupport>true</StackTraceSupport>
    <!-- WinRT AOT 诊断级别 1：自定义控件跨 ABI 暴露必须过这一档（R5） -->
    <CsWinRTAotWarningLevel>1</CsWinRTAotWarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- 静态资源随 exe 分发到输出目录的 Assets/ 下，由 Theming/AppAssets.cs 按
         AppContext.BaseDirectory 解析（非打包模式没有 ms-appx:/// 虚拟根）。

         项类型必须按扩展名分开写，原因（发布版丢图标踩过一次）：
         WinUI SDK 先把 *.png 收进 Content 默认项，只对它们写 None Update 是空操作；
         而 Content 项缺 CopyToPublishDirectory 时 dotnet build 会复制、dotnet publish 不会，
         结果 build 输出 34 个资源、publish 只剩 6 个（.ico/.svg），发布版段位奖章、
         分路与资源统计图标全空。因此 *.png 走 Content Update 并显式给两个元数据。
         重复 Include 会触发 NETSDK1022，故一律用 Update 而非 Include。 -->
    <Content Update="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <!-- .ico/.svg 不在 SDK 默认 Content 集内，属 None 默认项，Update 有效。
         svg 用通配覆盖全部子目录（Tier\、MatchDetail\ 与根目录的 opgg.svg），
         新增矢量资源不必再改本文件。 -->
    <None Update="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets\**\*.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 段位奖章（10 张）、分路位置（5 张）、Logo 与 opgg-nav 均由上面的
         Assets\**\*.png 规则覆盖，不再逐目录声明；MatchDetail 已全部矢量化。 -->
  </ItemGroup>

  <ItemGroup>
    <!-- App 只依赖 Core（ADR-02），Core 不得反向依赖任何 UI 类型 -->
    <ProjectReference Include="../YuumiX.Core/YuumiX.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SettingsExpander 调和决策层为 internal，供 R15 回归测试直接测（tests/YuumiX.App.Tests） -->
    <InternalsVisibleTo Include="YuumiX.App.Tests" />
  </ItemGroup>

  <!--
    WinUI 自包含载荷会把全部 86 种语言的 XAML 框架 MUI 资源（Microsoft.ui.xaml.dll.mui、
    Microsoft.UI.Xaml.Phone.dll.mui，每种语言一对，约 3.8 MB）复制进输出目录。保留名单与应用
    内置的三种语言设置（I18nService：zh-CN / zh-TW / en-US）对齐，en-us 兼作 MUI 回退基准；
    其余 83 种在复制清单里直接剔除，发布目录、便携 zip、安装包三者同步受益。

    过滤点挂在 AddMicrosoftWindowsAppSDKPayloadFilesFromComponents 之后：WASDK 在该目标里
    把载荷（含 **\*.mui）收进 None 项，build 与 publish（含 AOT）的复制都走这批 None 项，
    此刻剔除即单点覆盖两条链路。这些是纯内容文件，不进 deps.json，剔除后无清单悬空。
    语言目录取自 Identity 的上级目录名（源路径 <pkg>\runtimes-framework\win-x64\native\<语言>\*.mui
    与目标相对路径同构）；不能用 Link 元数据——部分 None 项（app.manifest 等）未定义它，
    批处理引用会报 MSB4096。若 WASDK 升级后载荷改道（不再经 None），本目标会静默失灵，
    语言目录会重新出现在产物里——release.yml 的 Verify publish output 有对应断言兜底。
  -->
  <Target Name="PruneWinUiMuiLanguages" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <ItemGroup>
      <None Remove="%(None.Identity)"
            Condition="'%(Extension)' == '.mui' and
                       !$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(Identity)'))).StartsWith('en-us', StringComparison.OrdinalIgnoreCase)) and
                       !$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(Identity)'))).StartsWith('zh-CN', StringComparison.OrdinalIgnoreCase)) and
                       !$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(Identity)'))).StartsWith('zh-TW', StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
  </Target>

  <!-- 非打包模式下应用自身的 PRI 必须手动带到 publish 输出。
       WinUI 的构建目标只把 YuumiX.pri 生成/复制到 TargetDir，`dotnet publish` 不会
       把它搬进 PublishDir —— 与 Assets 那次（PNG 走 None Update 只进 build 不进 publish）
       属同一类退化，症状更重：缺 PRI 时 XAML 解析不到 ms-appx 资源，
       进程在创建窗口阶段就崩在 Microsoft.UI.Xaml.dll，事件日志记
       STATUS_STOWED_EXCEPTION (0xc000027b)，表现为「双击没反应、进程立刻消失」。
       实测：Release TargetDir 有 2.2 MB 的 YuumiX.pri，publish 目录只有 5 个框架 pri。 -->
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_AppPriFiles Include="$(TargetDir)$(TargetName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_AppPriFiles)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).pri')" />
  </Target>

</Project>
