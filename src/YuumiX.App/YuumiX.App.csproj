<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- 产品名与根命名空间分离：exe 叫 YuumiX，代码命名空间保留 .App 分层，
         便于后续新增 YuumiX.Core 等领域项目。 -->
    <AssemblyName>YuumiX</AssemblyName>
    <RootNamespace>YuumiX.App</RootNamespace>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- exe 内嵌图标：资源管理器 / 快捷方式 / 任务栏在窗口尚未 SetIcon 时都读这一份。
         多尺寸只写在 .ico 里，不要在此处指定 PNG（PE 资源仅接受 .ico）。 -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <!-- Reactor 需要显式平台；省略 -p:Platform 会触发 WindowsAppSDKSelfContained 错误。
         仅保留 x64：英雄联盟客户端只有 x64 版本，无需 ARM64（见 slnx 注释）。 -->
    <Platforms>x64</Platforms>
    <!-- SelfContained 需要 RID：显式声明，避免依赖 Platform 推导 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <!-- 非打包模式：与原 Yuumi 的便携版分发形态一致，且无需 MSIX 注册即可运行 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <NoWarn>$(NoWarn);REACTOR_THEME_001</NoWarn>
    <!-- 门禁终态（AGENTS.md §0 / R17）：BannedApiAnalyzers 的 RS0030 随警告转错误，
         引用 BannedSymbols.txt 中禁用 API 的代码直接构建失败，取代"记得去跑"的人工 grep。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.UI.Reactor" />
    <!-- 设置项容器（SettingsCard/SettingsExpander）。控件模板在包内 .pri 中，
         裁剪/AOT 时必须保留该程序集，见 Controls/ToolkitXamlMetadata.cs。 -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <!-- 纯分析器包：只进编译，不进运行时输出 -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- BannedSymbols.txt 的条目格式与文档注释 ID 一致（T:/M:/P:），条目含义见文件内注释 -->
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- 静态资源随 exe 分发到输出目录的 Assets/ 下，由 Theming/AppAssets.cs 按
         AppContext.BaseDirectory 解析（非打包模式没有 ms-appx:/// 虚拟根）。
         用 None + Update 而非 Content Include：.png/.ico 已被 SDK 默认 None 项包含，
         重复 Include 会触发 NETSDK1022。 -->
    <None Update="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Logo.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 段位奖章图标（来自原 Yuumi 的 src/assets/ranked-icons，10 个段位各一张）。
         生涯页的排位表按 tier 取图，路径由 Theming/AppAssets 统一解析。 -->
    <None Update="Assets\RankedIcons\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 对局详情双方资源统计图标（来自原 Yuumi 的 public/images/，kills/tower/dragon/baron/herald/inhibitor）。 -->
    <None Update="Assets\MatchDetail\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Tier\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\opgg.svg" CopyToOutputDirectory="PreserveNewest" />
    <!-- 侧边栏 OP.GG 菜单项专用 18px 品牌图标（由 opgg.svg 光栅化；Reactor 的
         ImageIcon 走 BitmapImage，不支持 SVG，故必须用 PNG）。 -->
    <None Update="Assets\opgg-nav.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 召唤师峡谷分路位置图标（上/野/中/下/辅 5 张 PNG）。 -->
    <None Update="Assets\Positions\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- App 只依赖 Core（ADR-02），Core 不得反向依赖任何 UI 类型 -->
    <ProjectReference Include="../YuumiX.Core/YuumiX.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SettingsExpander 调和决策层为 internal，供 R15 回归测试直接测（tests/YuumiX.App.Tests） -->
    <InternalsVisibleTo Include="YuumiX.App.Tests" />
  </ItemGroup>

</Project>
