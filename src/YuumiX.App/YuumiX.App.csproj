<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- 产品名与根命名空间分离：exe 叫 YuumiX，代码命名空间保留 .App 分层，
         便于后续新增 YuumiX.Core 等领域项目。 -->
    <AssemblyName>YuumiX</AssemblyName>
    <RootNamespace>YuumiX.App</RootNamespace>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- exe 内嵌图标：资源管理器 / 快捷方式 / 任务栏在窗口尚未 SetIcon 时都读这一份。
         多尺寸只写在 .ico 里，不要在此处指定 PNG（PE 资源仅接受 .ico）。 -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <!-- Reactor 需要显式平台；省略 -p:Platform 会触发 WindowsAppSDKSelfContained 错误 -->
    <Platforms>x64;ARM64</Platforms>
    <!-- SelfContained 需要 RID：通过解决方案构建时 Platform 不会自动推导 RID，这里显式映射 -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <!-- 非打包模式：与原 Yuumi 的便携版分发形态一致，且无需 MSIX 注册即可运行 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.UI.Reactor" />
  </ItemGroup>

  <ItemGroup>
    <!-- 静态资源随 exe 分发到输出目录的 Assets/ 下，由 Theming/AppAssets.cs 按
         AppContext.BaseDirectory 解析（非打包模式没有 ms-appx:/// 虚拟根）。
         用 None + Update 而非 Content Include：.png/.ico 已被 SDK 默认 None 项包含，
         重复 Include 会触发 NETSDK1022。 -->
    <None Update="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- App 只依赖 Core（ADR-02），Core 不得反向依赖任何 UI 类型 -->
    <ProjectReference Include="../YuumiX.Core/YuumiX.Core.csproj" />
  </ItemGroup>

</Project>
