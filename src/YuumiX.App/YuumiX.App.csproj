<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- 产品名与根命名空间分离：exe 叫 YuumiX，代码命名空间保留 .App 分层，
         便于后续新增 YuumiX.Core 等领域项目。 -->
    <AssemblyName>YuumiX</AssemblyName>
    <RootNamespace>YuumiX.App</RootNamespace>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- exe 内嵌图标：资源管理器 / 快捷方式 / 任务栏在窗口尚未 SetIcon 时都读这一份。
         多尺寸只写在 .ico 里，不要在此处指定 PNG（PE 资源仅接受 .ico）。 -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <!-- 仅保留 x64：英雄联盟客户端只有 x64 版本，无需 ARM64（见 slnx 注释）。
         平台不再靠 -p:Platform 推导：RID 显式写死 win-x64，省略 -p:Platform 也能正常构建。 -->
    <Platforms>x64</Platforms>
    <!-- SelfContained 需要 RID：显式声明，避免依赖 Platform 推导 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <!-- 非打包模式：与原 Yuumi 的便携版分发形态一致，且无需 MSIX 注册即可运行 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <NoWarn>$(NoWarn);REACTOR_THEME_001</NoWarn>
    <!-- 门禁终态（AGENTS.md §0 / R17）：BannedApiAnalyzers 的 RS0030 随警告转错误，
         引用 BannedSymbols.txt 中禁用 API 的代码直接构建失败，取代"记得去跑"的人工 grep。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 不引 Microsoft.WindowsAppSDK 元包：它会把 AI / ML / Search / Widgets 四组组件
         一并拉进来，其中 AI 带 onnxruntime.dll(20.7M) + DirectML.dll(17.8M)，全仓零使用，
         压缩后白占约 14MB。改为只引真正用到的子包。 -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <!-- WinUI 2.3.9 声明的下限是 InteractiveExperiences >= 2.1.8，但该版本并不存在
         （实际只有 2.1.9），不直接引用就会报 NU1603。直接引用即钉住解析结果。 -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.UI.Reactor" />
    <!-- 设置项容器（SettingsCard/SettingsExpander）。控件模板在包内 .pri 中，
         裁剪/AOT 时必须保留该程序集，见 Controls/ToolkitXamlMetadata.cs。 -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <!-- 纯分析器包：只进编译，不进运行时输出 -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- BannedSymbols.txt 的条目格式与文档注释 ID 一致（T:/M:/P:），条目含义见文件内注释 -->
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- 静态资源随 exe 分发到输出目录的 Assets/ 下，由 Theming/AppAssets.cs 按
         AppContext.BaseDirectory 解析（非打包模式没有 ms-appx:/// 虚拟根）。

         项类型必须按扩展名分开写，原因（发布版丢图标踩过一次）：
         WinUI SDK 先把 *.png 收进 Content 默认项，只对它们写 None Update 是空操作；
         而 Content 项缺 CopyToPublishDirectory 时 dotnet build 会复制、dotnet publish 不会，
         结果 build 输出 34 个资源、publish 只剩 6 个（.ico/.svg），发布版段位奖章、
         分路与资源统计图标全空。因此 *.png 走 Content Update 并显式给两个元数据。
         重复 Include 会触发 NETSDK1022，故一律用 Update 而非 Include。 -->
    <Content Update="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <!-- .ico/.svg 不在 SDK 默认 Content 集内，属 None 默认项，Update 有效。 -->
    <None Update="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets\Tier\*.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets\opgg.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 段位奖章（10 张）、资源统计（11 张）、分路位置（5 张）、Logo 与 opgg-nav 均由
         上面的 Assets\**\*.png 规则覆盖，不再逐目录声明。 -->
  </ItemGroup>

  <ItemGroup>
    <!-- App 只依赖 Core（ADR-02），Core 不得反向依赖任何 UI 类型 -->
    <ProjectReference Include="../YuumiX.Core/YuumiX.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SettingsExpander 调和决策层为 internal，供 R15 回归测试直接测（tests/YuumiX.App.Tests） -->
    <InternalsVisibleTo Include="YuumiX.App.Tests" />
  </ItemGroup>

  <!-- 非打包模式下应用自身的 PRI 必须手动带到 publish 输出。
       WinUI 的构建目标只把 YuumiX.pri 生成/复制到 TargetDir，`dotnet publish` 不会
       把它搬进 PublishDir —— 与 Assets 那次（PNG 走 None Update 只进 build 不进 publish）
       属同一类退化，症状更重：缺 PRI 时 XAML 解析不到 ms-appx 资源，
       进程在创建窗口阶段就崩在 Microsoft.UI.Xaml.dll，事件日志记
       STATUS_STOWED_EXCEPTION (0xc000027b)，表现为「双击没反应、进程立刻消失」。
       实测：Release TargetDir 有 2.2 MB 的 YuumiX.pri，publish 目录只有 5 个框架 pri。 -->
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_AppPriFiles Include="$(TargetDir)$(TargetName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_AppPriFiles)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).pri')" />
  </Target>

</Project>
