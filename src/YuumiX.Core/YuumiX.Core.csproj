<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      刻意使用不带 -windows 的 TFM：
      Core 不触碰任何 UI / WinRT 类型，纯 CLR 目标可在无 Windows 桌面栈的
      环境里跑单测，并让「Core 禁止 using Microsoft.UI.Xaml」这条约束在编译期即被强化
      （一旦误引 WinUI 类型，此处会直接编译失败，而不是等到人工审查）。
    -->
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>YuumiX.Core</RootNamespace>

    <!-- 解决方案平台只有 x64，库项目需显式声明才能被方案平台映射 -->
    <Platforms>x64</Platforms>
    <IsPackable>false</IsPackable>

    <!--
      持续 AOT / 裁剪诊断（docs/internal/2026-11-01-native-aot-requirements.md R1）：
      Core 的 JSON 序列化已全部改为源生成路径，据此声明 AOT 兼容；
      之后任何回退到反射序列化 / 反射加载的改动都会在此项目直接产生 IL2026/IL3050 警告。
      App 侧的 AOT 门禁见 YuumiX.App.csproj 的 PublishAot 条件属性组。
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Locales\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interop 细节保持 internal，仅对测试项目开放 -->
    <InternalsVisibleTo Include="YuumiX.Core.Tests" />
    <!-- AOT 验收进程需要复用生产 options 形态与 internal 模型（DownloadCheckpoint / CacheDocument / CoreJsonContext） -->
    <InternalsVisibleTo Include="YuumiX.AotVerification" />
  </ItemGroup>

</Project>
