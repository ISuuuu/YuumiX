<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      刻意使用不带 -windows 的 TFM：
      Core 不触碰任何 UI / WinRT 类型，纯 CLR 目标可在无 Windows 桌面栈的
      环境里跑单测，并让「Core 禁止 using Microsoft.UI.Xaml」这条约束在编译期即被强化
      （一旦误引 WinUI 类型，此处会直接编译失败，而不是等到人工审查）。
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>YuumiX.Core</RootNamespace>

    <!-- 解决方案平台只有 x64，库项目需显式声明才能被方案平台映射 -->
    <Platforms>x64</Platforms>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Locales\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interop 细节保持 internal，仅对测试项目开放 -->
    <InternalsVisibleTo Include="YuumiX.Core.Tests" />
  </ItemGroup>

</Project>
